backend:
  name: git-gateway
  branch: main

# Carpeta donde se guardan las fotos que subís (quedan en el repo y las ve todo el mundo)
# Estas rutas asumen que la tienda vive en /tienda-nueva/ dentro del repo.
media_folder: "tienda-nueva/images/uploads"
public_folder: "/tienda-nueva/images/uploads"

locale: "es"

collections:
  - name: "tienda"
    label: "Tienda"
    files:
      - name: "catalogo"
        label: "Productos, rubros y portada"
        file: "products.json"
        description: "Editá precios, descuentos, stock y fotos. Al tocar Publish se publica para todos."
        fields:
          - label: "Productos"
            name: "items"
            widget: "list"
            label_singular: "Producto"
            summary: "{{fields.name}} — ${{fields.price}}"
            fields:
              - { label: "ID", name: "id", widget: "number", value_type: "int", hint: "Número único, no repetir (ej: 106)." }
              - { label: "Nombre", name: "name", widget: "string" }
              - { label: "Rubro", name: "cat", widget: "select", options: ["Tecnología para el hogar", "Mascotas", "Seguridad familiar", "Bienestar"] }
              - { label: "Precio", name: "price", widget: "number", value_type: "int", hint: "Si usás descuento por %, este es el precio de lista." }
              - { label: "Descuento %", name: "off", widget: "number", value_type: "int", default: 0, required: false, hint: "Ej: 15. El precio final se calcula solo. Dejá 0 si no hay descuento." }
              - { label: "Precio anterior (tachado)", name: "old", widget: "number", value_type: "int", default: 0, required: false, hint: "Alternativa al %: el precio de arriba es el final y este se muestra tachado. Dejá 0 si no lo usás." }
              - { label: "Con stock", name: "stock", widget: "boolean", default: true }
              - { label: "Etiqueta “Nuevo”", name: "nuevo", widget: "boolean", default: false, required: false }
              - { label: "Características", name: "desc", widget: "text", required: false, hint: "Una por línea. Se muestran como lista." }
              - { label: "Foto principal", name: "img", widget: "image", required: false, hint: "Cuadrada o vertical, fondo claro. Es la que se ve en la grilla." }
              - { label: "Más fotos (hasta 2)", name: "gallery", widget: "list", required: false, max: 2, field: { label: "Foto", name: "src", widget: "image" }, hint: "Otros ángulos. Se ven como miniaturas en la ficha del producto." }

          - label: "Rubros"
            name: "rubros"
            widget: "list"
            label_singular: "Rubro"
            min: 4
            max: 4
            summary: "{{fields.cat}}"
            fields:
              - { label: "Rubro", name: "cat", widget: "select", options: ["Tecnología para el hogar", "Mascotas", "Seguridad familiar", "Bienestar"] }
              - { label: "Descripción corta", name: "blurb", widget: "string" }
              - { label: "Foto de portada", name: "img", widget: "image", required: false, hint: "Horizontal, 16:9." }

          - label: "Portada (carrusel)"
            name: "slides"
            widget: "list"
            label_singular: "Diapositiva"
            min: 1
            max: 4
            summary: "{{fields.title}}"
            fields:
              - { label: "Título", name: "title", widget: "string" }
              - { label: "Subtítulo", name: "sub", widget: "text" }
              - { label: "Foto de fondo", name: "img", widget: "image", required: false, hint: "Imagen horizontal (1600×900). Se ve detrás del texto." }

          - label: "Configuración"
            name: "config"
            widget: "object"
            fields:
              - { label: "WhatsApp (con código de país)", name: "whatsapp", widget: "string", required: false, hint: "Ej: 5493511234567" }
              - { label: "Cintillo superior", name: "cintillo", widget: "string" }
              - { label: "Costo de envío", name: "envioCosto", widget: "number", value_type: "int" }
              - { label: "Envío gratis desde", name: "envioGratisDesde", widget: "number", value_type: "int", hint: "Poné 0 para desactivarlo." }
              - { label: "Mensaje de consulta por WhatsApp", name: "waConsulta", widget: "text" }
